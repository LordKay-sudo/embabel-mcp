# Required for Embabel bootstrap (use OpenRouter free tier or OpenAI)
OPENAI_API_KEY=your_openrouter_or_openai_key
OPENAI_BASE_URL=https://openrouter.ai

# BioInsight Graph FastAPI (start bioinsight-graph api first)
BIOINSIGHT_API_BASE_URL=http://localhost:8000/api/v1
BIOINSIGHT_WEB_UI_URL=http://localhost:8080

# Context control: minimal | standard | full
BIOINSIGHT_MCP_TOOL_PROFILE=standard
BIOINSIGHT_MCP_MAX_RESPONSE_CHARS=16000
BIOINSIGHT_MCP_DEFAULT_DISEASE_LIMIT=10

# Human-in-the-loop WaitFor forms (interactive Embabel only — keep false for Cursor/MCP)
BIOINSIGHT_HITL_ENABLED=false

# MCP server HTTP port (SSE at http://localhost:1337/sse)
MCP_SERVER_PORT=1337

# Optional KG RAG Demo bridge (Phase 4) — start kg-rag-demo API on :8001 first
KG_RAG_ENABLED=false
KG_RAG_API_BASE_URL=http://localhost:8001/api/v1
